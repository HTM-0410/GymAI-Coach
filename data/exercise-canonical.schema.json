{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gymaicoach.local/schemas/exercise-canonical.schema.json",
  "title": "GymAI Coach canonical exercise",
  "type": "object",
  "required": ["slug", "name", "name_vi", "instructions", "gallery", "primary_muscle", "equipment", "media_metadata"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 2},
    "name_vi": {"type": "string", "minLength": 2},
    "subtitle_vi": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "movement_pattern": {"type": "string"},
    "exercise_type": {"type": "string", "enum": ["compound", "isolation"]},
    "difficulty": {"type": "string", "enum": ["beginner", "intermediate", "advanced"]},
    "primary_muscle": {"type": "string"},
    "secondary_muscles": {"type": "array", "items": {"type": "string"}},
    "equipment": {"type": "array", "items": {"type": "string"}},
    "gallery": {"type": "object", "required": ["main", "views", "caption_vi"]},
    "instructions": {"type": "array", "items": {"type": "string"}},
    "translation_status": {"type": "string", "enum": ["machine_pending", "llm_pending", "review_required", "approved"]},
    "source": {"type": "object"},
    "media_metadata": {"type": "object"},
    "default_tracking_mode": {"type": "string", "enum": ["weight_reps", "reps", "duration", "duration_distance"], "default": "reps"},
    "allowed_tracking_modes": {"type": "array", "items": {"type": "string", "enum": ["weight_reps", "reps", "duration", "duration_distance"]}, "minItems": 1, "uniqueItems": true, "default": ["reps"]},
    "tracking_mode_review_status": {"type": "string", "enum": ["reviewed", "needs_review"], "default": "needs_review"},
    "tracking_mode_source": {"type": "string", "default": "safe_fallback"},
    "load_basis": {"type": "string", "enum": ["external_total", "per_implement", "assistance", "none"], "default": "none"}
  },
  "additionalProperties": true
}
