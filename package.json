{
  "name": "gymai-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "next lint",
    "test:workout-phases": "tsx --test tests/workout-phases.test.ts",
    "test:personalization": "tsx --test tests/personalization-context.test.ts",
    "test:ai-personalization": "tsx --test tests/ai-personalization-integration.test.ts",
    "test:qa:safety": "tsx --test tests/qa-safety.test.ts",
    "test:qa:completion": "tsx --test tests/qa-completion.test.ts",
    "test:qa:content": "tsx --test tests/qa-content.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:qa:release": "tsx --test tests/qa-safety.test.ts tests/qa-completion.test.ts tests/qa-content.test.ts tests/personalization-context.test.ts tests/workout-phases.test.ts",
    "recovery:backfill:dry": "tsx scripts/backfill-muscle-readiness.ts --days=14",
    "recovery:backfill:write": "tsx scripts/backfill-muscle-readiness.ts --days=14 --write",
    "exercises:batch:parallel": "tsx scripts/generate-exercises.ts --parallel 5",
    "exercises:batch:resume": "tsx scripts/generate-exercises.ts --resume",
    "exercises:batch:dry": "tsx scripts/generate-exercises.ts --dry-run",
    "exercises:gen": "tsx scripts/generate-exercises.ts",
    "exercises:gen:skip": "tsx scripts/generate-exercises.ts --skip-existing",
    "exercises:gen:dry": "tsx scripts/generate-exercises.ts --dry-run",
    "exercises:gen:limit": "tsx scripts/generate-exercises.ts --limit 10 --dry-run",
    "exercises:validate-taxonomy": "tsx scripts/validate-exercise-taxonomy.ts",
    "equipment:scrape": "tsx scripts/scrape-equipment-images.ts",
    "exercises:scrape-images": "tsx scripts/scrape-exerciselibrary-images.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@opennextjs/cloudflare": "1.14.8",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@types/three": "^0.185.4",
    "body-highlighter": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.453.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.185.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "wrangler": "^4.53.0"
  }
}
